# Thin wrapper around the official Workbench image for the mock-IdP E2E stack.
#
# The stock image has no cont-init.d/s6-overlay pre-start hook, so trusting
# the stack's shared CA and writing the SAML rserver.conf lines before rserver
# starts requires overriding the entrypoint, the same
# pattern used for OIDC (see docker/workbench/entrypoint-oidc.sh).
ARG PWB_VERSION=latest
FROM ghcr.io/posit-dev/workbench:${PWB_VERSION}

COPY entrypoint-saml.sh /usr/local/bin/entrypoint-saml.sh
COPY startup.sh /usr/local/bin/vip-create-test-user.sh
RUN chmod +x /usr/local/bin/entrypoint-saml.sh /usr/local/bin/vip-create-test-user.sh

# entrypoint-saml.sh ends in `exec "$@"`, so CMD names the stock entrypoint
# ahead of supervisord rather than supervisord alone. The image's own
# ENTRYPOINT is /usr/local/bin/entrypoint.sh -- it installs the sssd
# supervisord program and then execs its argument -- and dropping it would
# silently skip whatever base-image setup it grows next. compose.yml chains
# it the same way for the password-auth stack.
ENTRYPOINT ["/usr/local/bin/entrypoint-saml.sh"]
CMD ["/usr/local/bin/entrypoint.sh", "/usr/bin/supervisord", "-c", "/etc/supervisor/supervisord.conf"]
