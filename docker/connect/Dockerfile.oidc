# Thin wrapper around the official Connect image for the mock-IdP E2E stack.
#
# The stock Connect image has no cont-init.d-style pre-start hook -- like
# Workbench (see docker/workbench/Dockerfile.oidc), its ENTRYPOINT is unset
# and CMD runs its own startup script directly -- so trusting the stack's
# shared CA before the Connect process starts requires overriding the
# entrypoint.
#
# ghcr.io/posit-dev/connect provides the current Connect image with the
# OAuth2 configuration keys this stack requires.
ARG PCT_VERSION=latest
FROM ghcr.io/posit-dev/connect:${PCT_VERSION}

# The mounted gcfg replaces the image's own, which names its bundled Python by
# patch version. Link whichever one this image ships to a fixed path so a
# Python patch bump in a new Connect release doesn't stop Connect starting.
# Fails the build unless exactly one versioned Python is present.
RUN set -eu; \
    pythons=$(ls -1 /opt/python | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true); \
    if [ "$(printf '%s\n' "$pythons" | grep -c .)" -ne 1 ]; then \
      echo "Expected exactly one /opt/python/<version>, found: $(echo ${pythons:-none})" >&2; \
      exit 1; \
    fi; \
    ln -s "/opt/python/${pythons}" /opt/python/vip-default; \
    /opt/python/vip-default/bin/python --version

COPY entrypoint-oidc.sh /usr/local/bin/entrypoint-oidc.sh
RUN chmod +x /usr/local/bin/entrypoint-oidc.sh

ENTRYPOINT ["/usr/local/bin/entrypoint-oidc.sh"]
CMD ["/usr/local/bin/startup.sh"]
