---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="Example Report - VIP">
  <Header />

  <div class="page-header">
    <div class="container">
      <h1>Example Validation Report</h1>
      <p>
        A sample report generated by running VIP against Connect, Workbench, and Package Manager
        in CI. This report is rebuilt automatically whenever the website is deployed.
      </p>
      <p class="how-to">
        This example runs a curated subset of VIP's scenarios (the ones most useful to preview at
        a glance), not the full suite. Run <code>vip verify</code> against your own deployment to
        see every scenario that applies to your configuration.
      </p>
      <p class="how-to">
        For a regulated environment, the
        <a href={`${base}compliance-report/`}>compliance traceability report</a> is a
        second example: a narrower run joined against a control list, so every
        control links to the scenarios that verify it.
      </p>
      <p class="how-to">
        Generate your own: run <code>vip verify</code> to save test results to
        <code>report/results.json</code>, then <code>vip report</code> to render the report.
        Note: <code>vip report</code> runs Quarto under the hood, so you must
        have the <a href="https://quarto.org/docs/download/">quarto CLI</a> installed.
      </p>
      <div class="report-actions">
        <a href={`${base}example-report/vip-report.pdf`} class="pdf-button" download>
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1Z"></path>
            <path d="M2 11.75a.75.75 0 0 1 1.5 0v1.5c0 .14.11.25.25.25h8.5c.14 0 .25-.11.25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 13.25v-1.5Z"></path>
          </svg>
          Download PDF report
        </a>
        <a
          href={`${base}example-report/`}
          class="open-link"
          target="_blank"
          rel="noopener"
        >
          Open in new tab &#8599;
        </a>
      </div>
    </div>
  </div>

  <main class="report-frame-wrapper">
    <iframe
      src={`${base}example-report/`}
      title="Example VIP validation report"
      class="report-frame"
    ></iframe>
  </main>

  <Footer />
</Layout>

<style>
  .page-header {
    background: white;
    border-bottom: 1px solid var(--posit-border);
    padding: 2rem 1.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--posit-gray-900);
  }

  .page-header p {
    color: var(--posit-text-muted);
    font-size: 1.0625rem;
    max-width: 640px;
    margin-bottom: 0.75rem;
  }

  .how-to {
    font-size: 0.9375rem;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .report-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .pdf-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--posit-blue);
    color: white;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius);
    transition: background 0.15s;
  }

  .pdf-button:hover {
    background: var(--posit-link-hover);
    color: white;
  }

  .open-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--posit-blue);
  }

  .open-link:hover {
    color: var(--posit-link-hover);
  }

  .report-frame-wrapper {
    background: white;
  }

  .report-frame {
    display: block;
    width: 100%;
    height: calc(100vh - 64px - 120px);
    min-height: 600px;
    border: none;
    border-top: 1px solid var(--posit-border);
  }
</style>
