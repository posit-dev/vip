---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="Getting Started - VIP">
  <Header />

  <div class="page-header">
    <div class="container">
      <h1>Getting Started</h1>
      <p>Validate your Posit Team deployment in minutes.</p>
    </div>
  </div>

  <main class="content">
    <div class="container">
      <aside class="toc">
        <h4>On this page</h4>
        <ul>
          <li><a href="#install">Install</a></li>
          <li><a href="#smoke-test">Run a first test</a></li>
          <li><a href="#your-server">Run against your server</a></li>
          <li><a href="#next-steps">Next steps</a></li>
        </ul>
      </aside>

      <article class="docs" data-guide-url={`${base}guide/`}>
        <section id="install">
          <h2>Install</h2>
          <pre><code>uv tool install posit-vip
vip install</code></pre>
          <p>
            <code>vip install</code> installs Playwright's Chromium browser
            and the system libraries it needs. You can remove them later, along
            with other test artifacts, with <code>vip uninstall</code>.
          </p>
          <p>
            Run VIP from your own workstation or a CI runner, not from the
            Connect, Workbench, or Package Manager servers. On a headless
            host, see
            <a href={`${base}guide/#authentication`}>Authentication</a>.
          </p>
        </section>

        <section id="smoke-test">
          <h2>Run a first test</h2>
          <p>Run VIP against Posit Public Package Manager:</p>
          <pre><code>vip verify --package-manager-url https://p3m.dev</code></pre>
          <p>
            The command should finish in under a minute and show a successful
            run with some tests skipped.
          </p>
        </section>

        <section id="your-server">
          <h2>Run against your server</h2>
          <p>If you have Connect set up, run against it like this:</p>
          <pre><code>vip verify --connect-url https://connect.example.com --interactive-auth</code></pre>
          <p>
            The <code>--interactive-auth</code> flag opens a Chromium window so
            you can log in. After authentication completes, VIP runs the test
            suite headlessly and cleans up the session automatically.
          </p>
          <p>
            If you have an API key, you can skip browser auth with
            <code>--api-auth</code>:
          </p>
          <pre><code>export VIP_CONNECT_API_KEY="your-api-key"
vip verify --connect-url https://connect.example.com --api-auth</code></pre>
          <p>
            If some tests fail, fix what is wrong and rerun just those tests
            with <code>--filter</code>:
          </p>
          <pre><code>vip verify --connect-url https://connect.example.com --interactive-auth --filter test_deploy_shiny</code></pre>
          <p>
            To check other products, add <code>--workbench-url</code> and
            <code>--package-manager-url</code>. Run <code>vip --help</code> to
            see every option.
          </p>
        </section>

        <section id="next-steps">
          <h2>Next steps</h2>
          <p>The <a href={`${base}guide/`}>User Guide</a> covers the rest:</p>
          <ul>
            <li><a href={`${base}guide/#authentication`}>Authentication</a>: pick the right login mode, including headless and CI.</li>
            <li><a href={`${base}guide/#running-tests`}>Running tests</a>: categories, filters, and troubleshooting.</li>
            <li><a href={`${base}guide/#configuration-file`}>Configuration file</a>: keep your deployment settings in <code>vip.toml</code>.</li>
            <li><a href={`${base}guide/#outbound-proxy`}>Running behind a proxy</a></li>
            <li><a href={`${base}guide/#generating-reports`}>Generating reports</a></li>
            <li><a href={`${base}guide/#extending-vip`}>Extending VIP</a>: add your own tests.</li>
            <li><a href={`${base}guide/#pinned-version`}>Installing a pinned version</a> and <a href={`${base}guide/#uninstalling`}>Uninstalling</a></li>
          </ul>
        </section>
      </article>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .page-header {
    background: white;
    border-bottom: 1px solid var(--posit-border);
    padding: 3rem 1.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--posit-gray-900);
  }

  .page-header p {
    color: var(--posit-text-muted);
    font-size: 1.0625rem;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .content .container {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 3rem;
    padding: 2.5rem 1.5rem;
  }

  .toc {
    position: sticky;
    top: calc(var(--header-height) + 1rem);
    align-self: start;
    order: 1;
  }

  .toc h4 {
    font-size: 0.8125rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--posit-text-muted);
    margin-bottom: 0.75rem;
    font-family: var(--font-mono);
  }

  .toc ul {
    list-style: none;
    padding: 0;
  }

  .toc li {
    margin-bottom: 0.375rem;
  }

  .toc a {
    font-size: 0.8125rem;
    color: var(--posit-text-muted);
  }

  .toc a:hover {
    color: var(--posit-blue);
  }

  .docs {
    order: 0;
    min-width: 0;
  }

  .docs section {
    scroll-margin-top: calc(var(--header-height) + 1rem);
    margin-bottom: 3rem;
  }

  .docs h2 {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--posit-navy);
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--posit-border);
  }

  .docs h3 {
    scroll-margin-top: calc(var(--header-height) + 1rem);
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--posit-navy);
    margin-top: 1.5rem;
    margin-bottom: 0.75rem;
  }

  .docs p {
    margin-bottom: 1rem;
    color: var(--posit-gray-900);
  }

  .docs ul {
    margin-bottom: 1rem;
    padding-left: 1.5rem;
  }

  .docs li {
    margin-bottom: 0.375rem;
  }

  .docs pre {
    margin-bottom: 1rem;
    position: relative;
  }

  .docs pre :global(.copy-btn) {
    position: absolute;
    top: 0.375rem;
    right: 0.375rem;
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 4px;
    padding: 0.25rem 0.5rem;
    font-size: 0.75rem;
    font-family: var(--font-mono);
    cursor: pointer;
    transition: background 0.15s, color 0.15s;
  }

  .docs pre :global(.copy-btn:hover) {
    background: rgba(255, 255, 255, 0.2);
    color: white;
  }

  .docs pre :global(.copy-btn.copied) {
    background: var(--posit-teal);
    color: white;
    border-color: var(--posit-teal);
  }

  .table-wrap {
    overflow-x: auto;
    margin-bottom: 1rem;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    font-size: 0.875rem;
  }

  th,
  td {
    text-align: left;
    padding: 0.625rem 0.75rem;
    border-bottom: 1px solid var(--posit-border);
  }

  th {
    font-weight: 600;
    color: var(--posit-navy);
    background: var(--posit-gray-bg);
  }

  @media (max-width: 768px) {
    .content .container {
      grid-template-columns: 1fr;
    }

    .toc {
      display: none;
    }
  }
</style>

<script>
  document.querySelectorAll(".docs pre").forEach((pre) => {
    const btn = document.createElement("button");
    btn.className = "copy-btn";
    btn.textContent = "Copy";
    btn.addEventListener("click", async () => {
      const code = pre.querySelector("code");
      if (!code) return;
      await navigator.clipboard.writeText(code.textContent || "");
      btn.textContent = "Copied!";
      btn.classList.add("copied");
      setTimeout(() => {
        btn.textContent = "Copy";
        btn.classList.remove("copied");
      }, 2000);
    });
    pre.appendChild(btn);
  });
</script>

<script>
  // Sections that moved to the User Guide keep their old URLs working.
  const moved = [
    "authentication",
    "running-tests",
    "configuration-file",
    "outbound-proxy",
    "generating-reports",
    "extending-vip",
    "uninstalling",
  ];
  const id = window.location.hash.slice(1);
  const guide = document.querySelector<HTMLElement>(".docs")?.dataset.guideUrl;
  if (guide && moved.includes(id)) {
    window.location.replace(`${guide}#${id}`);
  }
</script>
