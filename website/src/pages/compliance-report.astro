---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const base = import.meta.env.BASE_URL;
---

<Layout title="Compliance Report - VIP">
  <Header />

  <div class="page-header">
    <div class="container">
      <h1>Compliance Traceability Report</h1>
      <p>
        A second, narrower run against the same CI Connect deployment: only the
        21 CFR Part 11 example extension that ships with VIP, joined against that
        example&rsquo;s <code>controls.toml</code>. The Compliance Traceability
        section is the point &mdash; every control, the scenarios that verify it,
        their outcome, and the timestamp each check ran.
      </p>
      <p class="how-to">
        The <a href={`${base}report/`}>standard example report</a> is a broad smoke
        run across Connect, Workbench and Package Manager with no control list
        attached, so it has no such section and its summary counts many more
        scenarios. The two differ in scope, not in machinery: both are rendered by
        the same <code>vip report</code>, and any VIP run can carry a matrix by
        attaching a control list.
      </p>
      <p class="how-to">
        Generate your own: run
        <code>vip scaffold --template 21cfr-part11-validation --output ./my-tests</code>
        to get a worked <code>controls.toml</code> and tagged scenarios, replace them
        with your own regulatory mapping, then
        <code>vip verify --extensions ./my-tests</code> followed by
        <code>vip report --controls ./my-tests/controls.toml</code>. The same matrix
        exports to CSV or JSON with <code>vip trace</code>.
      </p>
      <p class="how-to">
        Read the matrix carefully. This example uses a five-control list, three of
        them automated. Controls you mark <code>manual</code> or
        <code>procedural</code> are reported as not verifiable by automated test,
        which is deliberately distinct from a coverage gap, and a control whose
        scenario was skipped is reported as covered but not executed. A green matrix
        evidences the controls you chose to automate, on the deployment you pointed
        VIP at, at the time it ran. It is not an attestation of compliance.
      </p>
      <div class="report-actions">
        <a
          href={`${base}example-compliance-report/vip-report.pdf`}
          class="pdf-button"
          download
        >
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
            <path d="M8 1a.75.75 0 0 1 .75.75v6.69l2.22-2.22a.75.75 0 1 1 1.06 1.06l-3.5 3.5a.75.75 0 0 1-1.06 0l-3.5-3.5a.75.75 0 1 1 1.06-1.06l2.22 2.22V1.75A.75.75 0 0 1 8 1Z"></path>
            <path d="M2 11.75a.75.75 0 0 1 1.5 0v1.5c0 .14.11.25.25.25h8.5c.14 0 .25-.11.25-.25v-1.5a.75.75 0 0 1 1.5 0v1.5A1.75 1.75 0 0 1 12.25 15h-8.5A1.75 1.75 0 0 1 2 13.25v-1.5Z"></path>
          </svg>
          Download PDF report
        </a>
        <a
          href={`${base}example-compliance-report/`}
          class="open-link"
          target="_blank"
          rel="noopener"
        >
          Open in new tab &#8599;
        </a>
      </div>
    </div>
  </div>

  <main class="report-frame-wrapper">
    <iframe
      src={`${base}example-compliance-report/`}
      title="Example VIP compliance traceability report"
      class="report-frame"
    ></iframe>
  </main>

  <Footer />
</Layout>

<style>
  .page-header {
    background: white;
    border-bottom: 1px solid var(--posit-border);
    padding: 2rem 1.5rem;
  }

  .page-header h1 {
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
    color: var(--posit-gray-900);
  }

  .page-header p {
    color: var(--posit-text-muted);
    font-size: 1.0625rem;
    max-width: 640px;
    margin-bottom: 0.75rem;
  }

  .how-to {
    font-size: 0.9375rem;
  }

  .container {
    max-width: var(--max-width);
    margin: 0 auto;
  }

  .report-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-top: 0.5rem;
  }

  .pdf-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--posit-blue);
    color: white;
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.625rem 1.25rem;
    border-radius: var(--radius);
    transition: background 0.15s;
  }

  .pdf-button:hover {
    background: var(--posit-link-hover);
    color: white;
  }

  .open-link {
    display: inline-flex;
    align-items: center;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--posit-blue);
  }

  .open-link:hover {
    color: var(--posit-link-hover);
  }

  .report-frame-wrapper {
    background: white;
  }

  .report-frame {
    display: block;
    width: 100%;
    height: calc(100vh - 64px - 120px);
    min-height: 600px;
    border: none;
    border-top: 1px solid var(--posit-border);
  }
</style>
